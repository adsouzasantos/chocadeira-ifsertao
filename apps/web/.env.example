# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Nunca coloque a chave service_role aqui.

# URL do projeto, por exemplo https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (publishable key "sb_publishable_..." ou a antiga anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público da aplicação, usado nos links enviados por e-mail
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Endereço do broker MQTT exibido nas instruções de configuração do ESP32 (informação pública)
NEXT_PUBLIC_MQTT_HOST=
