# Serviço de ingestão. Este arquivo NUNCA deve ir para o front-end nem para o Git.

# Broker MQTT (ex.: HiveMQ Cloud). Use mqtts:// (TLS, porta 8883).
MQTT_URL=mqtts://seu-cluster.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=ingestor
MQTT_PASSWORD=
# Identificador fixo: o broker guarda as mensagens enquanto o serviço reinicia
MQTT_CLIENT_ID=ingestor-1

# Supabase: URL do projeto e chave service_role (Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Intervalo da verificação de dispositivos sem comunicação (segundos)
TIMEOUT_CHECK_INTERVAL_S=30
LOG_LEVEL=info

# Simulador: credenciais de UM dispositivo cadastrado no broker
SIM_DEVICE_KEY=
SIM_MQTT_USERNAME=
SIM_MQTT_PASSWORD=
