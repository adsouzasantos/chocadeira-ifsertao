{
  "name": "@chocadeira/ingestor",
  "version": "0.1.0",
  "private": true,
  "description": "Serviço de ingestão: recebe as mensagens MQTT dos ESP32, valida e grava no Supabase",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "simulate": "node --env-file-if-exists=.env dist/simulator.js",
    "simulate:dev": "tsx --env-file=.env src/simulator.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "mqtt": "^5.16.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chocadeira/shared": "*",
    "@types/node": "^22",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
